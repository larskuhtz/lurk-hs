cabal-version: 3.14
name: plonk-verify
version: 0.1.0
license: MIT
copyright: Copyright (c) 2024 Argument Computer Corporation

extra-doc-files:
    README.md

extra-source-files:
    rust/Cargo.toml
    rust/Cargo.lock
    rust/src/lib.rs

data-files:
    verifier-assets/v1.0.8-testnet/vk.bin

build-type: Hooks
-- build-type: Simple
custom-setup
    setup-depends:
        , Cabal
        , Cabal-hooks >=3.14
        , base
        , directory
        , process
        , containers >=0.7
        , bytestring
        , filepath

common warnings
    ghc-options: -Wall

-- library "internal"
--     import: warnings
--     default-language: Haskell2010
--     hs-source-dirs: .
--     exposed-modules:
--         SetupHooks
--     build-depends:
--         , Cabal
--         , Cabal-hooks >=3.14
--         , base
--         , directory
--         , containers

library
    import: warnings
    default-language: Haskell2010
    hs-source-dirs: src
    exposed-modules:
        PlonkBn254.Verify
        PlonkBn254.Utils.EmbedVMKeys
    other-modules:
        Rust
    autogen-modules:
        Rust
    build-depends:
        , base
        , base16-bytestring >=0.1.1.7
        , bytestring >=0.11.2
        , directory >=1.3
        , filepath >=1.4
        , template-haskell >=2.16
        , temporary >=1.3
        , vector >=0.12
    frameworks:
        CoreFoundation
        Security
    extra-bundled-libraries:
        Cplonk_verify
    ghc-options:
        -lplonk_verify

test-suite tests
    import: warnings
    default-language: Haskell2010
    type: exitcode-stdio-1.0
    hs-source-dirs: tests
    main-is: Main.hs
    hs-source-dirs: tests
    build-depends:
        , aeson >=2.2
        , base
        , base16-bytestring >=0.1.1.7
        , bytestring >=0.11.2
        , hspec >=2.11
        , plonk-verify
        , text >=2.1
